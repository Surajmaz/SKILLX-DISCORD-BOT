# Discord Bot Token (from Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Server / Guild ID for instant slash command registration during development
# Leave empty or 0 to register commands globally across all servers
GUILD_ID=

# Bot command prefixes (leave empty for prefix-less mode; use /slash, @mention, or direct words)
COMMAND_PREFIX=

# Web Dashboard Settings
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Leave empty to auto-generate a secure random password on startup, or set your own:
DASHBOARD_PASSWORD=
# HMAC secret key for dashboard sessions (auto-generated if left empty):
DASHBOARD_SECRET_KEY=
